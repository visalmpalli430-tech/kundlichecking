/* ── PICK RASHI ── */
window.pickRashi = function(id) {
  // Update selector highlight
  document.querySelectorAll('.rs-card').forEach(function(c){c.classList.remove('on');});
  document.getElementById('rs_'+id).classList.add('on');
  curRashi = id;
  setUrl(RASHIS[id].en, curPeriod);
  renderReading(id, curPeriod);
  document.getElementById('overviewGrid').style.display = 'none';
  document.getElementById('mainSub').style.display = 'none';
};

/* ── PERIOD SWITCH ── */
window.setPeriod = function(p) {
  curPeriod = p;
  document.querySelectorAll('.p-tab').forEach(function(t){t.classList.remove('on');});
  document.querySelector('.p-tab[data-p="'+p+'"]').classList.add('on');
  if (curRashi !== null) {
    setUrl(RASHIS[curRashi].en, p);
    renderReading(curRashi, p);
  }
};

/* ── RENDER READING ── */
function renderReading(id, period) {
  var r = RASHIS[id];
  var ov = rating(id,'overall',period);
  var lv = rating(id,'love',period);
  var cv = rating(id,'career',period);
  var hv = rating(id,'health',period);
  var lucky = getLucky(id, period);
  var pLabel = {daily:"Today's Reading",weekly:"This Week's Reading",monthly:"This Month's Reading"}[period];

  // Hero
  document.getElementById('readingHero').innerHTML =
    '<span class="rh-sym">'+r.sym+'</span>' +
    '<div class="rh-info">' +
      '<div class="rh-name">'+r.en+' <span class="rh-hi" style="font-family:\'Noto Sans Devanagari\',sans-serif;font-size:1.2rem;color:#E8B000">'+r.hi+'</span></div>' +
      '<div class="rh-meta">'+r.dates+' &nbsp;|&nbsp; Lord: <strong style="color:#FFD740">'+r.lord+'</strong> &nbsp;|&nbsp; '+r.el+' Sign</div>' +
      '<div class="rh-stars">'+stars(ov)+' Overall <span class="period-badge">'+pLabel+'</span></div>' +
    '</div>';

  // Category cards
  var cats = [
    {key:'love',    icon:'💕', title:'Love & Relationships', stars:lv, featured:false},
    {key:'career',  icon:'💼', title:'Career & Finance',     stars:cv, featured:false},
    {key:'health',  icon:'🌿', title:'Health & Wellness',    stars:hv, featured:false},
    {key:'overall', icon:'🌟', title:'Overall Guidance',     stars:ov, featured:true}
  ];
  document.getElementById('catGrid').innerHTML = cats.map(function(c) {
    return '<div class="cat-card'+(c.featured?' featured':'')+'">'+
      '<div class="cat-title">'+c.icon+' '+c.title+'</div>'+
      '<div class="cat-stars">'+stars(c.stars)+'</div>'+
      '<div class="cat-text">'+getReading(id, c.key, period)+'</div>'+
    '</div>';
  }).join('');

  // Lucky strip
  document.getElementById('luckyStrip').innerHTML =
    '<h4>🍀 Lucky for '+{daily:'Today',weekly:'This Week',monthly:'This Month'}[period]+'</h4>' +
    [
      {icon:'🎨',lbl:'Lucky Colour',val:lucky.color},
      {icon:'🔢',lbl:'Lucky Number',val:lucky.number},
      {icon:'💎',lbl:'Lucky Gemstone',val:lucky.gem},
      {icon:'🧭',lbl:'Lucky Direction',val:lucky.dir},
      {icon:'⏰',lbl:'Auspicious Time',val:lucky.time}
    ].map(function(l){
      return '<div class="lucky-item"><span class="lucky-icon">'+l.icon+'</span><div><span class="lucky-lbl">'+l.lbl+'</span><span class="lucky-val">'+l.val+'</span></div></div>';
    }).join('');

  // Vedic tip
  var tips = {
    daily:'Your planetary lord <strong>'+r.lord+'</strong> is active today. Light a diya and chant the '+r.lord+' mantra 21 times at sunrise for clarity, protection and positive energy throughout the day.',
    weekly:'This week, align your actions with <strong>'+r.lord+'</strong>\'s energy. Perform '+r.lord+' Puja on the auspicious day of the week to strengthen all positive planetary influences for seven days.',
    monthly:'This month, deepen your relationship with <strong>'+r.lord+'</strong>. Daily mantra chanting — 108 repetitions each morning — compounds into profound blessings over the full lunar cycle.'
  };
  document.getElementById('vedicTip').innerHTML =
    '<h4>📜 Vedic Tip — '+r.en+'</h4><p>'+tips[period]+'</p>';

  document.getElementById('readingWrap').className = 'reading-wrap show';
  setTimeout(function(){
    document.getElementById('readingWrap').scrollIntoView({behavior:'smooth',block:'nearest'});
  }, 80);
}

/* ── INIT ── */
buildSelector();
buildOverview();
// Check URL for direct rashi link
var urlRashi = getRashiFromUrl();
var params2  = new URLSearchParams(window.location.search);
var urlP     = params2.get('p');
if (urlP && ['daily','weekly','monthly'].indexOf(urlP) > -1) {
  curPeriod = urlP;
  document.querySelectorAll('.p-tab').forEach(function(t){t.classList.remove('on');});
  var tab = document.querySelector('.p-tab[data-p="'+curPeriod+'"]');
  if (tab) tab.classList.add('on');
}
if (urlRashi !== null) {
  pickRashi(urlRashi);
}
</script>

